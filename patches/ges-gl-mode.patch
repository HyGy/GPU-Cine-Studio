+GstElementFactory *
+ges_get_compositor_factory_for_mode (gboolean gl)
+{
+  static GstElementFactory *gl_factory = NULL;
+
+  if (!gl)
+    return ges_get_compositor_factory ();
+
+  if (!gl_factory)
+    gl_factory = gst_element_factory_find ("glvideomixer");
+
+  return gl_factory ? gl_factory : ges_get_compositor_factory ();
+}
+
+/* GL mode: a track (and the sources/transitions inside it) composited by
+ * glvideomixer keeps frames in GLMemory instead of round-tripping through
+ * system memory. It is chosen per track, at track creation time, from the
+ * GES_GL_MODE=1 environment variable (so a preview timeline and an export
+ * timeline can coexist with different modes) and stored in the track. */
+gboolean
+ges_gl_mode_requested (void)
+{
+  const gchar *v = g_getenv ("GES_GL_MODE");
+  GstElementFactory *f;
+
+  if (v == NULL || v[0] != '1')
+    return FALSE;
+
+  f = gst_element_factory_find ("glvideomixer");
+  if (!f)
+    return FALSE;
+  gst_object_unref (f);
+
+  return TRUE;
