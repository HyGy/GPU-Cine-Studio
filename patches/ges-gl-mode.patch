 static GstTimedValueControlSource *
 set_interpolation (GstObject * element, GESVideoTransitionPrivate * priv,
     const gchar * propname)
 {
   GstControlSource *control_source;
 
   g_object_set (element, propname, (gfloat) 0.0, NULL);
 
   control_source = gst_interpolation_control_source_new ();
   gst_object_add_control_binding (GST_OBJECT (element),
       gst_direct_control_binding_new (GST_OBJECT (element), propname,
           control_source));
   g_object_set (control_source, "mode", GST_INTERPOLATION_MODE_LINEAR, NULL);
 
   return GST_TIMED_VALUE_CONTROL_SOURCE (control_source);
 }
 
+/* gldownload ! videoconvert wrapped in a bin, for the CPU-only wipes */
+static GstElement *
+create_gl_download_convert (const gchar * name)
+{
+  GstElement *bin = gst_bin_new (name);
+  GstElement *down = gst_element_factory_make ("gldownload", NULL);
+  GstElement *conv = gst_element_factory_make ("videoconvert", NULL);
+  GstPad *pad, *ghost;
+
+  gst_bin_add_many (GST_BIN (bin), down, conv, NULL);
+  fast_element_link (down, conv);
+
+  pad = gst_element_get_static_pad (down, "sink");
+  ghost = gst_ghost_pad_new ("sink", pad);
+  gst_element_add_pad (bin, ghost);
+  gst_object_unref (pad);
+
+  pad = gst_element_get_static_pad (conv, "src");
+  ghost = gst_ghost_pad_new ("src", pad);
+  gst_element_add_pad (bin, ghost);
+  gst_object_unref (pad);
+
+  return bin;
+}
+
+/* glvideomixer has no compositor-style "operator": emulate "source" (pad A,
+ * replaces what is below) and "add" (pad B, adds on top) with blend
+ * functions so a crossfade does not dip dark in the middle. */
+static void
+set_gl_blend_functions (GESVideoTransitionPrivate * priv, gboolean is_fade)
+{
+  GObject *a = G_OBJECT (priv->mixer_sinka);
+  GObject *b = G_OBJECT (priv->mixer_sinkb);
+
+  if (!g_object_class_find_property (G_OBJECT_GET_CLASS (a),
+          "blend-function-src-rgb")) {
+    GST_WARNING ("glvideomixer pad has no blend functions");
+    return;
+  }
+
+  gst_util_set_object_arg (a, "blend-function-src-rgb", "src-alpha");
+  gst_util_set_object_arg (a, "blend-function-src-alpha", "one");
+  gst_util_set_object_arg (b, "blend-function-src-rgb", "src-alpha");
+  gst_util_set_object_arg (b, "blend-function-src-alpha", "one");
+  if (is_fade) {
+    gst_util_set_object_arg (a, "blend-function-dst-rgb", "zero");
+    gst_util_set_object_arg (a, "blend-function-dst-alpha", "zero");
+    gst_util_set_object_arg (b, "blend-function-dst-rgb", "one");
+    gst_util_set_object_arg (b, "blend-function-dst-alpha", "one");
+  } else {
+    /* "over" */
+    gst_util_set_object_arg (a, "blend-function-dst-rgb",
+        "one-minus-src-alpha");
+    gst_util_set_object_arg (a, "blend-function-dst-alpha",
+        "one-minus-src-alpha");
+    gst_util_set_object_arg (b, "blend-function-dst-rgb",
+        "one-minus-src-alpha");
+    gst_util_set_object_arg (b, "blend-function-dst-alpha",
+        "one-minus-src-alpha");
+  }
+}
