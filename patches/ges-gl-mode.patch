+static void
+restriction_caps_cb (GESTrack * track,
+    GParamSpec * arg G_GNUC_UNUSED, GESVideoTransition * self)
+{
+  GESVideoTransitionPrivate *priv = self->priv;
+  GstCaps *caps = NULL;
+
+  if (!priv->capsfilter)
+    return;
+
+  if (track)
+    g_object_get (track, "restriction-caps", &caps, NULL);
+
+  GST_DEBUG_OBJECT (self, "Setting transition output capsfilter caps to %"
+      GST_PTR_FORMAT, caps);
+  g_object_set (priv->capsfilter, "caps", caps, NULL);
+
+  if (caps)
+    gst_caps_unref (caps);
+}
